# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CARTO 3 Cloud Native API Credentials
# Used for live spatial BigQuery computations and geodetic analysis.
VITE_CARTO_API_BASE_URL="https://gcp-asia-northeast1.api.carto.com"
VITE_CARTO_ACCESS_TOKEN="YOUR_CARTO_ACCESS_TOKEN"
